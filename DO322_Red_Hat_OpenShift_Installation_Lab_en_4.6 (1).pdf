    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Red Hat OpenShift Installation Lab</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Red&amp;#160;Hat OpenShift Installation Lab (DO322) teaches essential skills for installing an OpenShift cluster in a range of environments, from proof of concept to production. Students also learn how to identify customizations that might be required because of the underlying cloud, virtual, or physical infrastructure.</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
